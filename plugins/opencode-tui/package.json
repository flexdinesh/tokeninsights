{
  "name": "@tokeninsights/opencode-tui",
  "version": "1.0.0",
  "description": "TokenInsights OpenCode TUI plugin",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild index.tsx --bundle --platform=node --format=esm --target=node24 --jsx=automatic --jsx-import-source=@opentui/solid --outfile=dist/index.js --external:@opencode-ai/plugin --external:@opencode-ai/plugin/tui --external:solid-js --external:@opentui/solid --external:@opentui/solid/jsx-runtime --external:@opentui/solid/jsx-dev-runtime --external:better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "esbuild": "^0.25.0"
  }
}
