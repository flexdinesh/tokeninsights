    }
  ],
  "narrative": {
    "northStar": "Quiet Blue — White First",
    "overview": "White First is a mature measurement workspace: white surfaces, neutral gray supporting regions, precise typography, and restrained blue actions. Its dark theme uses neutral charcoal and soft white ink with the same hierarchy.\n\nLocally bundled DM Sans, tabular numerals, and compact section spacing support repeated inspection. Preserve the TokenInsights text wordmark, offline assets, explicit states, and existing analytical behavior.\n\nThis browser contract derives from the token layers and primitives in [`packages/web/src/ui/`](packages/web/src/ui/). Frontmatter colors record each semantic role's light value and its `dark-` counterpart, resolved through the palette; the design guard test fails when they drift. Architecture remains in [docs/design.md](docs/design.md); terminal styling in [packages/cli/DESIGN.md](packages/cli/DESIGN.md).",
    "keyCharacteristics": [
      "White light surfaces and neutral charcoal dark surfaces.",
      "Blue actions, selection, focus, and principal chart series.",
      "Sidebar navigation, a compact current-view heading, and rule-separated analytics.",
      "Wrapping filters, scalable type, and visible keyboard focus.",
      "One component library owns appearance; features own layout."
    ],
    "rules": [
      {
        "name": "The One Owner Rule",
        "body": "A color, size or state lives in one token or one primitive. Features never restyle a primitive's color, border or typography.",
        "section": "overview"
      },
      {
        "name": "The Neutral Surface Rule",
        "body": "Keep large surfaces white or neutral gray in light mode and neutral charcoal in dark mode. Blue belongs to feedback and plotted data; readout values remain neutral.",
        "section": "colors"
      },
      {
        "name": "The Selection Rule",
        "body": "Every selected state is the `selected` tint with `selected-ink` and no border: navigation, segmented controls, date presets, active filter triggers and chips. `aria-pressed`, `aria-current=\"page\"` or the Button `selected` prop drive it through one `selected:` variant.",
        "section": "colors"
      },
      {
        "name": "The Readable Measurement Rule",
        "body": "Use tabular numerals and right-aligned numeric columns. Reflow controls before reducing type; retain the user's root font size and complete timeline dates.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use fine rules and surface tone at rest. Reserve the overlay shadow for floating layers.",
        "section": "elevation"
      },
      {
        "name": "The Visible Focus Rule",
        "body": "Every focusable element shows a 2px `focus` outline with a 2px offset (`focus-ring`). Inside clipped regions (navigation, table scroll, resize handles) the outline insets (`focus-ring-inset`); search wrappers own their outline (`focus-ring-within`).",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do use blue for actions, selection, focus, and the principal plotted series.",
      "Do keep both themes neutral, with readable supporting ink.",
      "Do add a semantic role before adding a color, size or layer; reference it from a primitive.",
      "Do use shared control sizes, visible focus, and enlarged touch targets.",
      "Do wrap filters, navigation, and chart controls; keep every view reachable.",
      "Do keep source identity, complete dates, and result summaries readable at enlarged text sizes."
    ],
    "donts": [
      "Don't tint large workspace surfaces blue.",
      "Don't add separate metric cards or selection borders to static readouts.",
      "Don't rely on color alone for selection, categories, or status.",
      "Don't use palette variables, raw colors or arbitrary Tailwind values in features.",
      "Don't override a primitive's color, border or type from a feature; add a variant instead."
    ]
  }
}
