  "components": [
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Filled blue action for primary form submissions.",
      "html": "<button type=\"button\" class=\"ds-button-default\">Sign in</button>",
      "css": ".ds-button-default{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:var(--control-height);padding:0.25rem 0.75rem;border:var(--border-width) solid transparent;border-radius:var(--radius-md);font:500 var(--text-body)/1.43 var(--font-sans);cursor:pointer;transition:background-color var(--duration-fast),color var(--duration-fast);background:var(--action);color:var(--action-ink);}.ds-button-default:hover{background:color-mix(in srgb,var(--action) 90%,transparent);}.ds-button-default:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:var(--focus-offset);}.ds-button-default:disabled{opacity:var(--opacity-disabled);pointer-events:none;}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Field-edged control for toolbar and table actions.",
      "html": "<button type=\"button\" class=\"ds-button-outline\">Columns</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:var(--control-height);padding:0.25rem 0.75rem;border:var(--border-width) solid transparent;border-radius:var(--radius-md);font:500 var(--text-body)/1.43 var(--font-sans);cursor:pointer;transition:background-color var(--duration-fast),color var(--duration-fast);background:var(--surface);color:var(--ink);border-color:var(--line-strong);}.ds-button-outline:hover{background:var(--surface-hover);color:var(--ink-hover);}.ds-button-outline:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:var(--focus-offset);}.ds-button-outline:disabled{opacity:var(--opacity-disabled);pointer-events:none;}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Muted control for navigation-like actions; blue on hover.",
      "html": "<button type=\"button\" class=\"ds-button-quiet\">Sign out</button>",
      "css": ".ds-button-quiet{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:var(--control-height);padding:0.25rem 0.75rem;border:var(--border-width) solid transparent;border-radius:var(--radius-md);font:500 var(--text-body)/1.43 var(--font-sans);cursor:pointer;transition:background-color var(--duration-fast),color var(--duration-fast);background:transparent;color:var(--ink-muted);}.ds-button-quiet:hover{background:var(--surface-hover);color:var(--ink-hover);}.ds-button-quiet:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:var(--focus-offset);}.ds-button-quiet:disabled{opacity:var(--opacity-disabled);pointer-events:none;}"
    },
    {
      "name": "Link Button",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Inline text action: drill-downs, clear actions, disclosures.",
      "html": "<button type=\"button\" class=\"ds-button-link\">Show directories</button>",
      "css": ".ds-button-link{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:var(--control-height);padding:0.25rem 0.75rem;border:var(--border-width) solid transparent;border-radius:var(--radius-md);font:500 var(--text-body)/1.43 var(--font-sans);cursor:pointer;transition:background-color var(--duration-fast),color var(--duration-fast);background:transparent;color:var(--ink-subtle);padding:0;}.ds-button-link:hover{color:var(--ink-hover);text-decoration:underline;text-underline-offset:var(--underline-offset);}.ds-button-link:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:var(--focus-offset);}.ds-button-link:disabled{opacity:var(--opacity-disabled);pointer-events:none;}"
    },
    {
      "name": "Selected Control",
      "kind": "button",
      "refersTo": "control-selected",
      "description": "Shared selected state: tint and blue ink, no border. Driven by aria-pressed, aria-current or selected.",
      "html": "<button type=\"button\" class=\"ds-selected\" aria-pressed=\"true\">Monthly</button>",
      "css": ".ds-selected{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:var(--control-height);padding:0.25rem 0.75rem;border:var(--border-width) solid transparent;border-radius:var(--radius-md);font:500 var(--text-body)/1.43 var(--font-sans);cursor:pointer;transition:background-color var(--duration-fast),color var(--duration-fast);min-height:var(--control-height-compact);font-size:var(--text-label);border-radius:var(--radius-sm);background:var(--selected);color:var(--selected-ink);}.ds-selected:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:var(--focus-offset);}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Labelled input on the field surface with a strong edge; invalid fields take the danger edge.",
      "html": "<label class=\"ds-field\"><span>Key name</span><input class=\"ds-input\" placeholder=\"Work laptop\"></label>",
      "css": ".ds-field{display:grid;gap:0.25rem;font:500 var(--text-body)/1.43 var(--font-sans);color:var(--ink);}.ds-input{min-height:var(--control-height);padding:0.25rem 0.75rem;border:var(--border-width) solid var(--line-strong);border-radius:var(--radius-md);background:var(--surface-field);color:var(--ink);font:400 var(--text-body)/1.43 var(--font-sans);caret-color:var(--action);}.ds-input:hover{background:var(--surface-raised);}.ds-input:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:var(--focus-offset);}.ds-input[aria-invalid=true]{border-color:var(--status-danger);}"
    },
    {
      "name": "View Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Sidebar view links; the current page uses the selected tint.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Tokens</a><a href=\"#\">Models</a><a href=\"#\">Sessions</a></nav>",
      "css": ".ds-nav{display:grid;gap:0.25rem;width:12rem;padding:0.75rem;background:var(--surface-rail);font:500 var(--text-body)/1.43 var(--font-sans);}.ds-nav a{display:flex;align-items:center;min-height:var(--control-height);padding:0.25rem 0.75rem;border-radius:var(--radius-md);color:var(--ink-muted);text-decoration:none;}.ds-nav a:hover{background:var(--surface-hover);color:var(--ink-hover);}.ds-nav a[aria-current=page]{background:var(--selected);color:var(--selected-ink);}.ds-nav a:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:calc(-1 * var(--focus-width));}"
