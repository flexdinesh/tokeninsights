  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Existing shared primary Button variant; dashboard actions may use compact sizing.",
      "html": "<button class=\"ds-button-primary\">Sync Usage</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:var(--control-height-md);padding:0.375rem 0.75rem;border:var(--border-width) solid transparent;border-radius:var(--radius-md);background:var(--primary);color:var(--primary-foreground);font:500 var(--text-sm)/1.5 var(--font-sans);cursor:pointer;transition:background var(--duration-fast),color var(--duration-fast),border-color var(--duration-fast);}.ds-button-primary:hover:not(:disabled){background:color-mix(in srgb,var(--primary) 90%,transparent);}.ds-button-primary:focus-visible{outline:var(--focus-width) solid var(--ring);outline-offset:var(--focus-offset);}.ds-button-primary:disabled{opacity:0.5;cursor:default;pointer-events:none;}@media(max-width:38rem),(pointer:coarse){.ds-button-primary{min-height:2.75rem;}}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
