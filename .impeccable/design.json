      "description": "Underlined active view in a horizontally scrolling row.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Analytics views\"><a href=\"#tokens\" aria-current=\"page\">Tokens</a><a href=\"#models\">Models</a><a href=\"#providers\">Providers</a></nav>",
      "css": ".ds-nav{display:flex;gap:var(--space-1);overflow-x:auto;}.ds-nav a{display:inline-flex;align-items:center;min-height:var(--control-height);padding:var(--space-2) var(--space-3);border-bottom:var(--focus-width) solid transparent;color:var(--muted-foreground);background:transparent;white-space:nowrap;text-decoration:none;font:400 var(--text-sm)/1.5 var(--font-sans);}.ds-nav a:hover{background:var(--secondary);color:var(--foreground);}.ds-nav a[aria-current]{background:transparent;color:var(--accent-foreground);border-color:var(--accent-foreground);font-weight:600;}.ds-nav a:focus-visible{outline:var(--focus-width) solid var(--ring);outline-offset:calc(-1 * var(--focus-width));}@media(max-width:38rem),(pointer:coarse){.ds-nav a{min-height:2.75rem;}}"
    },
    {
      "name": "Active Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Dimension and selected value with a removal action.",
      "html": "<button class=\"ds-chip\" aria-label=\"Remove model example\"><span class=\"ds-chip-label\">Model</span><span class=\"ds-chip-value\">example</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:var(--space-2);min-height:var(--control-height-compact);max-width:100%;padding:var(--space-1) var(--space-2);background:var(--accent);color:var(--accent-foreground);border:var(--border-width) solid var(--accent-foreground);border-radius:var(--radius-sm);font:500 var(--text-xs)/1.5 var(--font-sans);cursor:pointer;}.ds-chip-label{color:var(--muted-foreground);}.ds-chip-value{max-width:15rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.ds-chip:hover{border-color:var(--primary);}.ds-chip:focus-visible{outline:var(--focus-width) solid var(--ring);outline-offset:var(--focus-offset);}@media(max-width:38rem),(pointer:coarse){.ds-chip{min-height:2.75rem;}}"
    },
    {
      "name": "Ordinary Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Shared bordered container outside flat analytics regions.",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-heading\">Refreshing usage</div><div class=\"ds-card-content\">Syncing all supported harnesses…</div></div>",
      "css": ".ds-card{background:var(--card);color:var(--foreground);border:var(--border-width) solid var(--border);border-radius:var(--radius-lg);font:400 var(--text-sm)/1.5 var(--font-sans);}.ds-card-heading{padding:1rem var(--panel-padding);font-weight:600;}.ds-card-content{padding:0 var(--panel-padding) var(--panel-padding);color:var(--muted-foreground);}"
    },
    {
      "name": "Static Readout",
      "kind": "custom",
      "refersTo": "total-readout",
      "description": "Plain measurement group, without an individual card or control state.",
      "html": "<div class=\"ds-readout\"><span class=\"ds-readout-label\">Total tokens</span><strong aria-label=\"Total tokens: 647000\">647K</strong><span class=\"ds-readout-detail\">Canonical, countable usage</span></div>",
      "css": ".ds-readout{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-1);color:var(--foreground);background:transparent;font-family:var(--font-sans);}.ds-readout-label{color:var(--secondary-foreground);font-size:var(--text-xs);font-weight:500;}.ds-readout strong{font-size:var(--text-readout);font-weight:600;line-height:var(--leading-tight);letter-spacing:var(--tracking-tight);font-variant-numeric:tabular-nums;}.ds-readout-detail{color:var(--muted-foreground);font-size:var(--text-xs);line-height:1.5;}"
    }
  ],
  "narrative": {
    "northStar": "Graphite & Lime",
    "overview": "Graphite & Lime is a compact measurement workspace: neutral graphite in dark mode, warm white in light mode, and crisp lime feedback. Fine rules, static readouts, and dense rows keep measurements close together.\n\nSystem typography, tabular numerals, restrained motion, and explicit states support repeated inspection. Preserve the TokenInsights logo and offline assets; no remote fonts are needed.",
    "keyCharacteristics": [
      "Graphite dark surfaces and warm light surfaces.",
      "Lime actions and selection; neutral readout values.",
      "Flat, rule-separated analytics with compact controls.",
      "Wrapping filters, scalable type, and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Lime Roles Rule",
        "body": "Use lime for actions, selection, focus, and the principal plotted series. Readout values remain neutral; category colors follow their corresponding labels.",
        "section": "colors"
      },
      {
        "name": "The Readable Measurement Rule",
        "body": "Use tabular numerals and right-aligned numeric columns. Reflow controls before reducing type; retain the user's root font size and complete timeline dates.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use fine rules and surface tone at rest. Reserve the shared shadow for overlays and chart tooltips.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve lime feedback in both themes, using the deeper light-theme ink for readable text and chart lines.",
      "Do use shared control sizes, visible focus, and enlarged touch targets.",
      "Do wrap filters and chart controls; keep every view reachable on narrow screens.",
      "Do keep source identity, complete timeline dates, and full-result summaries readable at enlarged text sizes."
    ],
    "donts": [
      "Don't add separate metric cards or selection borders to static readouts.",
      "Don't introduce a tall dashboard title block or side filter rail into this compact surface.",
      "Don't rely on color alone for selection, categories, or status.",
      "Don't add decorative chart animation, remote fonts, or arbitrary overlay shadows."
    ]
  }
}
