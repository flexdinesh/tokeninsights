      "css": ".ds-chip{display:inline-flex;align-items:center;gap:0.5rem;min-height:var(--control-height-compact);padding:0 0.625rem;border:0;border-radius:var(--radius-sm);background:var(--selected);color:var(--selected-ink);font:500 var(--text-label)/1.33 var(--font-sans);cursor:pointer;}.ds-chip-dim{color:var(--ink-muted);}.ds-chip:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:var(--focus-offset);}"
