      "facts": [],
      "countable_fact_count": 0,
      "total_tokens": 0
    }
  },
  "variants": [
    {
      "name": "same_batch",
      "submissions": [
        {
          "batch_label": "batch-concurrent",
          "collector_stream": "stream-A",
          "journal_sequences": [
            1,
            2
          ],
          "include_sessions": [
            "session_A"
          ],
          "include_facts": [
            "fact_A",
            "fact_B"
          ]
        },
        {
          "batch_label": "batch-concurrent",
          "collector_stream": "stream-A",
          "journal_sequences": [
            1,
            2
          ],
          "include_sessions": [
            "session_A"
          ],
          "include_facts": [
            "fact_A",
            "fact_B"
          ]
        }
      ],
      "expected": {
        "accepted_requests": 2,
        "same_receipt": true
      },
      "expected_server": {
        "owner_A": {
          "sessions": [
            "session-A"
          ],
          "facts": [
            "fact_A",
            "fact_B"
          ],
