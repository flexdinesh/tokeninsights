{
  "name": "@tokeninsights/opencode-server",
  "version": "1.0.0",
  "description": "TokenInsights OpenCode server plugin",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "node --check src/index.ts && node --check src/writer-client.ts && node --check src/oc-tokeninsights-writer.ts",
    "build": "pnpm run check && tsup && node scripts/build-dist.mjs",
    "vendor": "pnpm --filter @tokeninsights/opencode-server --prod deploy ./deploy"
  },
  "dependencies": {
    "@tokeninsights/logger": "workspace:*"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
