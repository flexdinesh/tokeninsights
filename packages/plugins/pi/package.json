{
  "name": "@tokeninsights/pi",
  "version": "1.0.0",
  "description": "Token and TPS tracking extension for Pi coding agent",
  "main": "./src/index.ts",
  "exports": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "check": "tsc --noEmit --module esnext --moduleResolution bundler --esModuleInterop --skipLibCheck src/index.ts",
    "build": "pnpm run check && tsup && node scripts/build-dist.mjs"
  },
  "dependencies": {
    "@tokeninsights/logger": "workspace:*"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.71.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
