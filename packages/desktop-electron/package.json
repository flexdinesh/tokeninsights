{
  "name": "@tokeninsights/desktop-electron",
  "version": "1.0.0",
  "private": true,
  "description": "TokenInsights Electron local dashboard",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs",
    "test": "tsc --noEmit && node --test test/*.test.ts",
    "install:runtime": "install-electron"
  },
  "dependencies": {
    "@tokeninsights/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "45.2.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
