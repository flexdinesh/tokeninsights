{
  "name": "tokeninsights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check-schema": "pnpm --filter check-schema run check-schema",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build:cli": "pnpm --filter @tokeninsights/cli run build",
    "install:cli": "cd packages/cli && go install ./cmd/tokeninsights",
    "build": "pnpm run check-schema && pnpm run build:cli",
    "test": "pnpm run test:scripts && pnpm --filter @tokeninsights/cli run test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "packageManager": "pnpm@11.6.0"
}
