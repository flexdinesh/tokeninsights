{
  "name": "tokeninsights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check-schema": "pnpm --filter check-schema run check-schema",
    "build:opencode-server": "pnpm --filter @tokeninsights/opencode-server run build",
    "build:opencode-tui": "pnpm --filter @tokeninsights/opencode-tui run build",
    "build:pi": "pnpm --filter pi-tokeninsights run build",
    "build:cli": "pnpm --filter tokeninsights-cli run build",
    "build": "pnpm run build:opencode-server && pnpm run build:opencode-tui && pnpm run build:pi && pnpm run build:cli",
    "test": "pnpm --filter tokeninsights-cli run test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
