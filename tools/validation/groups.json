{
  "common": [
    ".gitignore",
    "mise.toml",
    "mise.lock",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tools/validation/",
    ".oxfmtrc.json",
    ".oxlintrc.json",
    "packages/*/package.json",
    "tools/build/package.json",
    "docs-website/package.json",
    "dagger.json",
    "go.mod",
    "go.sum",
    "golangci-lint.mod",
    "golangci-lint.sum"
  ],
  "groups": {
    "format": {
      "inputs": [
        "*",
        ".agents/",
        ".github/",
        ".husky/",
        ".impeccable/",
        "assets/",
        "docs-website/",
        "docs/",
        "packages/",
        "schema/",
        "tools/"
      ],
      "executor": "host",
      "class": "light"
    },
    "static": {
      "inputs": [
        "packages/cli/",
        "packages/desktop/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "tools/build/",
        "orval.config.ts",
        "docs-website/",
        "packages/core/",
        "packages/backend/",
        "packages/dashboard/",
        "packages/contracts/",
        "install/",
        "install*.sh",
        ".github/workflows/"
      ],
      "executor": "dagger",
      "class": "light"
    },
    "web": {
      "inputs": [
        "DESIGN.md",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "packages/core/",
        "packages/backend/",
        "packages/desktop/",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "dagger",
      "class": "light"
    },
    "tooling": {
      "inputs": [
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "tools/build/",
        "orval.config.ts",
        ".husky/",
        ".github/workflows/",
        "install.sh",
        "packages/desktop/",
        ".gitattributes",
        ".gitignore",
        "LICENSE",
        "assets/",
        "packages/core/",
        "packages/backend/",
        "packages/dashboard/",
        "packages/contracts/",
        "install/",
        "install*.sh"
      ],
      "executor": "dagger",
      "class": "light"
