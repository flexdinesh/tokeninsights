{
  "common": [
    ".gitignore",
    "mise.toml",
    "mise.lock",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tools/validation/",
    ".oxfmtrc.json",
    ".oxlintrc.json",
    "packages/*/package.json",
    "tools/build/package.json",
    "docs-website/package.json"
  ],
  "contexts": {
    "deps": {
      "inputs": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "packages/*/package.json",
        "tools/build/package.json",
        "docs-website/package.json",
        "mise.toml",
        "mise.lock",
        "go.mod",
        "go.sum",
        "golangci-lint.mod",
        "golangci-lint.sum",
        "tools/validation/go.mod",
        "tools/validation/go.sum"
      ]
    },
    "web": {
      "inputs": [
        "packages/web/",
        "packages/dashboard/",
        "packages/contracts/",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts"
      ],
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/test-results/",
        "**/playwright-report/",
        "packages/web/e2e/",
        "packages/web/playwright.config.ts",
        "packages/web/scripts/",
        "packages/web/src/test-setup.ts",
        "**/node_modules/",
        "**/dist/"
      ]
    },
    "go": {
      "inputs": ["packages/cli/", "packages/backend/", "packages/core/"],
      "exclude": [
        "**/*_test.go",
        "**/testdata/",
        "**/fixtures/",
        "**/*.md",
        "**/node_modules/",
        "**/bin/",
        "packages/cli/.golangci.yml"
      ]
    }
  },
  "groups": {
    "format": {
      "inputs": [
        "*",
        ".agents/",
        ".github/",
        ".husky/",
        ".impeccable/",
        "assets/",
        "docs-website/",
        "docs/",
        "packages/",
        "schema/",
        "tools/"
      ],
      "executor": "host"
    },
    "static": {
      "inputs": [
        "go.mod",
        "go.sum",
        "golangci-lint.mod",
        "golangci-lint.sum",
        "packages/cli/",
        "packages/desktop/",
        "packages/desktop-native/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "tools/build/",
        "orval.config.ts",
        "docs-website/",
        "packages/core/",
        "packages/backend/",
        "packages/dashboard/",
        "packages/contracts/",
        "install/",
        "install*.sh",
        ".github/workflows/"
      ],
      "executor": "container",
      "uses": ["deps", "web"]
    },
    "web": {
      "inputs": [
        "DESIGN.md",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "container",
      "uses": ["deps"]
    },
    "tooling": {
      "inputs": [
        "go.mod",
        "go.sum",
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "tools/build/",
        "orval.config.ts",
        ".husky/",
        ".github/workflows/",
        "install.sh",
        "packages/desktop/",
        "packages/desktop-native/",
        ".gitattributes",
        ".gitignore",
        "LICENSE",
        "assets/",
        "docs-website/public/",
        "packages/core/",
        "packages/backend/",
        "packages/dashboard/",
        "packages/contracts/",
        "install/",
        "install*.sh"
      ],
      "executor": "container",
      "uses": ["deps"]
    },
    "go": {
      "inputs": [
        "go.mod",
        "go.sum",
        "packages/cli/",
        "packages/desktop/",
        "packages/desktop-native/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "tools/build/src/test-go.ts",
        "packages/core/",
        "packages/backend/",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "container",
      "uses": ["deps", "web"]
    },
    "benchmarks": {
      "inputs": [
        "go.mod",
        "go.sum",
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "tools/build/src/test-go.ts",
        "packages/core/",
        "packages/backend/",
        "packages/desktop/",
        "packages/desktop-native/",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "container",
      "uses": ["deps", "web"]
    },
    "distribution": {
      "inputs": [
        "go.mod",
        "go.sum",
        "LICENSE",
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
        ".gitignore",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "tools/build/src/test-distribution.ts",
        "packages/core/",
        "packages/backend/",
        "packages/desktop/",
        "packages/desktop-native/",
        "packages/dashboard/",
        "packages/contracts/",
        "install/",
        "install*.sh",
        ".github/workflows/",
        "tools/build/"
      ],
      "executor": "container",
      "uses": ["deps", "web"]
    },
    "browser": {
      "inputs": [
        "go.mod",
        "go.sum",
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "packages/core/",
        "packages/backend/",
        "packages/desktop/",
        "packages/desktop-native/",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "container",
      "uses": ["deps", "web", "go"]
    },
    "deployment": {
      "inputs": [
        "go.mod",
        "go.sum",
        "tools/build/src/test-personal-network.ts",
        "tools/build/src/dev-lifecycle.ts",
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "packages/core/",
        "packages/backend/",
        "packages/desktop/",
        "packages/desktop-native/",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "container",
      "uses": ["deps", "web", "go"]
    }
  }
}
