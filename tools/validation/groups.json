      "inputs": [
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "tools/build/src/test-go.ts",
        "packages/core/",
        "packages/backend/",
        "packages/desktop/",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "dagger",
      "class": "heavy"
    },
    "distribution": {
      "inputs": [
        "LICENSE",
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
