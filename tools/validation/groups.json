        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "packages/core/",
        "packages/backend/",
        "packages/desktop/",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "dagger",
      "class": "heavy"
    },
    "deployment": {
      "inputs": [
        "tools/build/src/test-personal-network.ts",
        "tools/build/src/dev-lifecycle.ts",
        "packages/cli/",
        "schema/",
        "docs/openapi.yaml",
        "packages/web/",
        "orval.config.ts",
        "tools/build/src/build-web.ts",
        "tools/build/src/sync-web-assets.ts",
        "tools/build/src/files.ts",
        "tools/build/src/workspace.ts",
        "packages/core/",
        "packages/backend/",
        "packages/desktop/",
        "packages/dashboard/",
        "packages/contracts/"
      ],
      "executor": "dagger",
      "class": "heavy"
    }
  }
}
